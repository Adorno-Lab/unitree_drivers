        <!-- Compositions: filled diamond on the owning end. DriverUnitreeG1 holds each Lego
             class by value, so the parts are created and destroyed with it. Each Lego class
             leaves its right side and enters the left side of DriverUnitreeG1 at its own
             height, so every line is attached to both boxes and stays straight. -->
        <mxCell id="comp-lowstate" edge="1" parent="1" source="lego-lowstate" target="driver" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1;entryDx=0;entryDy=0;endArrow=diamondThin;endFill=1;endSize=14;">
